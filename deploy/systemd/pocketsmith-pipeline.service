[Unit]
Description=PocketSmith nightly pipeline (sync -> transfers -> categorise -> push)
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/pocketsmith
EnvironmentFile=/data/pocketsmith.env
# Each ExecStart runs in order; a non-zero exit aborts the chain.
ExecStart=/usr/local/bin/pocketsmith sync
ExecStart=/usr/local/bin/pocketsmith transfers
ExecStart=/usr/local/bin/pocketsmith transfers --apply
ExecStart=/usr/local/bin/pocketsmith categorise
ExecStart=/usr/local/bin/pocketsmith push
